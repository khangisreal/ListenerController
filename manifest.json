{
  "manifest_version": 3,
  "name": "ListenerController",
  "version": "2.0.0",
  "description": "Detect and toggle website EventListeners on or off in real time.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ListenerController",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
